#!/bin/sh
# Runs the TrendsMesh engine in the plugin's pixi environment. Arguments pass through unchanged.
pj="$HOME/.trendsmesh/paths.json"
field() { [ -f "$pj" ] && sed -n "s/^ *\"$1\" *: *\"\\(.*\\)\",\\{0,1\\} *\$/\\1/p" "$pj" | sed 's/\\\\/\\/g; s/\\"/"/g'; }
ROOT=${TM_PLUGIN_ROOT:-$(field plugin_root)}
DATA=${TM_PLUGIN_DATA:-$(field plugin_data)}
if [ -z "$ROOT" ] || [ -z "$DATA" ]; then
  echo "tm: the plugin has not set itself up yet. Start a new Claude Code session, then try again. Never install anything yourself for it; if this stays, run /trendsmesh-playbooks:doctor." >&2
  exit 1
fi
export PIXI_HOME="$DATA/pixi" PIXI_NO_PATH_UPDATE=1 TM_PLUGIN_ROOT="$ROOT" TM_PLUGIN_DATA="$DATA"
if [ ! -x "$PIXI_HOME/bin/pixi" ] && [ ! -x "$PIXI_HOME/bin/pixi.exe" ]; then
  # Its install at session start failed: try once more, so a new session is not needed.
  case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*)
      ps1="$ROOT/bootstrap/install-pixi.ps1"
      command -v cygpath >/dev/null 2>&1 && ps1=$(cygpath -w "$ps1")
      install_pixi() { CLAUDE_PLUGIN_DATA="$DATA" powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ps1" -Report; } ;;
    *) install_pixi() { CLAUDE_PLUGIN_DATA="$DATA" sh "$ROOT/bootstrap/install-pixi.sh"; } ;;
  esac
  if ! why=$(install_pixi 2>&1 >/dev/null); then
    why=$(printf '%s' "$why" | tr '\n' ' ' | tr -d '\000-\037\177')
    echo "tm: the plugin's tools are not set up: pixi did not install into the plugin's data folder, and trying again just now failed too. The reason: ${why:-unknown}. Tell the user that reason in plain words: when a site could not be reached, their network, a proxy or firewall, or the app they run Claude in blocks it, and the sites the reason lists must be allowed. Never install pixi yourself or change PATH." >&2
    exit 1
  fi
fi
if [ ! -f "$PIXI_HOME/config.toml" ]; then
  mkdir -p "$PIXI_HOME"
  printf 'detached-environments = "%s/envs"\n' "$(printf '%s' "$DATA" | sed 's/\\/\\\\/g; s/"/\\"/g')" > "$PIXI_HOME/config.toml"
fi
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*) ;;
  *) exec "$PIXI_HOME/bin/pixi" run --frozen --manifest-path "$ROOT/env/pixi.toml" -e base python -m tm "$@" ;;
esac
# Windows (issue #123): tm runs on python.org's Python, signed by the Python Software Foundation, in the base tier's
# venv, <data>/venvs/base-<key>; pixi's environment gives it ffmpeg on PATH. <key>: the first 12 hex digits of the
# SHA-256 of the plugin root with / made \ and no trailing \ (as install-python.ps1 and tm/paths.py work it out).
winroot=$ROOT windata=$DATA
command -v cygpath >/dev/null 2>&1 && winroot=$(cygpath -w "$ROOT") && windata=$(cygpath -w "$DATA")
sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi; }
key=$(printf '%s' "$winroot" | tr '/' '\\' | sed 's/\\*$//' | sha256 | cut -c1-12)
export TM_PLUGIN_ROOT="$winroot" TM_PLUGIN_DATA="$windata"   # tm works the same key out of the same text
VENV="$DATA/venvs/base-$key"
PY="$VENV/Scripts/python.exe"
if [ ! -f "$PY" ] || [ ! -f "$VENV/tm-venv.json" ]; then
  # Its install at session start failed or did not finish: try once more, so a new session is not needed. The
  # folders go to PowerShell in Windows' own form, so it makes the venv where this script looks for it.
  ps1="$ROOT/bootstrap/install-python.ps1"
  command -v cygpath >/dev/null 2>&1 && ps1=$(cygpath -w "$ps1")
  if ! why=$(CLAUDE_PLUGIN_DATA="$windata" CLAUDE_PLUGIN_ROOT="$winroot" powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ps1" -Tier base -Report 2>&1 >/dev/null) \
      || [ ! -f "$VENV/tm-venv.json" ]; then
    why=$(printf '%s' "$why" | tr '\n' ' ' | tr -d '\000-\037\177')
    echo "tm: the plugin's tools are not set up: its Python did not install into the plugin's data folder, and trying again just now failed too. The reason: ${why:-unknown}. Tell the user that reason in plain words: when a site could not be reached, their network, a proxy or firewall, or the app they run Claude in blocks it, and the sites the reason lists must be allowed. Never install Python yourself or change PATH." >&2
    exit 1
  fi
fi
# Smart App Control can block a file of the plugin's Python (error 4551, issue #123). tm says so itself when it got
# far enough to run (exit 86 here); any other failure gets one probe in the same environment, and a block shows as
# the number or as Windows' own words for it.
TM_BLOCK_EXIT=86 "$PIXI_HOME/bin/pixi" run --frozen --manifest-path "$ROOT/env/pixi.toml" -e base "$PY" -m tm "$@"
code=$?
case $code in 0|2) exit $code ;; 86) exit 1 ;; esac
probe=$("$PIXI_HOME/bin/pixi" run --frozen --manifest-path "$ROOT/env/pixi.toml" -e base "$PY" -c "import ssl,_hashlib,_queue" 2>&1) && exit $code
if ! printf '%s\n' "$probe" | grep -qiE '(os error|winerror|error)[^0-9a-z]{0,3}4551([^0-9]|$)'; then
  words=$(powershell.exe -NoProfile -Command '[ComponentModel.Win32Exception]::new(4551).Message' 2>/dev/null | tr -d '\r' | sed 's/[. ]*$//' | head -n 1)
  [ -n "$words" ] && printf '%s\n' "$probe" | grep -qiF -- "$words" || exit $code
fi
file=$(printf '%s\n' "$probe" | sed -n 's/.*while importing \([^ :]*\).*/\1/p' | head -n 1)
FILE=${file:-python.exe} awk '
  /^ *smart_app_control: *"/ {
    sub(/^ *smart_app_control: *"/, ""); sub(/" *$/, "")
    i = index($0, "{file}"); if (i) $0 = substr($0, 1, i - 1) ENVIRON["FILE"] substr($0, i + 6)
    print; exit
  }' "$ROOT/data/i18n/en.yaml" >&2
echo "For Claude: tell the user these steps in plain words; it is no network or install failure. Never change Windows security settings yourself." >&2
exit 1
