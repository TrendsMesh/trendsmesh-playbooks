{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "PB3 proposals page data (tools/pb3/proposals_page.py)",
 "type": "object",
 "required": [
  "title",
  "date",
  "store",
  "channels",
  "proposals",
  "data_note",
  "run"
 ],
 "properties": {
  "lang": {"type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
  "title": {
   "type": "string"
  },
  "date": {
   "type": "string"
  },
  "default_output": {
   "enum": [
    "video",
    "script"
   ]
  },
  "store": {
   "type": "object",
   "required": [
    "name",
    "note"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "channels": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "niche"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "niche": {
      "type": "string"
     }
    }
   }
  },
  "already_made": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "proposals": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "channel",
     "title",
     "video_type",
     "approach",
     "why",
     "trends",
     "beats",
     "length",
     "recipe",
     "product",
     "risk",
     "cost"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "channel": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "video_type": {
      "type": "string"
     },
     "approach": {
      "description": "Recreate / Inspire (or the chat-language word)",
      "type": "string"
     },
     "why": {
      "type": "string"
     },
     "trends": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "role"
       ],
       "properties": {
        "id": {
         "description": "8-char trend id prefix; card_<id>.json and videos_<id>.json must exist in trends_dir",
         "type": "string"
        },
        "role": {
         "type": "string"
        },
        "pick": {
         "type": "array",
         "items": {
          "type": "integer"
         }
        }
       }
      }
     },
     "beats": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "length": {
      "type": "string"
     },
     "recipe": {
      "type": "object",
      "required": [
       "production",
       "voice",
       "music",
       "text"
      ],
      "properties": {
       "production": {
        "type": "string"
       },
       "voice": {
        "type": "string"
       },
       "music": {
        "type": "string"
       },
       "text": {
        "type": "string"
       }
      }
     },
     "product": {
      "type": "object",
      "required": [
       "level",
       "note"
      ],
      "properties": {
       "level": {
        "type": "string"
       },
       "note": {
        "type": "string"
       }
      }
     },
     "risk": {
      "type": "object",
      "required": [
       "level",
       "items"
      ],
      "properties": {
       "level": {
        "enum": [
         "low",
         "medium",
         "high"
        ]
       },
       "items": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     },
     "cost": {
      "type": "object",
      "required": [
       "low",
       "high",
       "note"
      ],
      "properties": {
       "low": {
        "type": "number"
       },
       "high": {
        "type": "number"
       },
       "note": {
        "type": "string"
       }
      }
     },
     "facts": {
      "type": "string"
     },
     "taste": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "data_note": {
   "type": "string"
  },
  "run": {
   "type": "string"
  }
 }
}
