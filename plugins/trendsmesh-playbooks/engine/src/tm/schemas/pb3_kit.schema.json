{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "PB3 posting kit",
 "type": "object",
 "required": [
  "id",
  "version",
  "date",
  "channel",
  "video",
  "platforms"
 ],
 "properties": {
  "id": {
   "type": "string"
  },
  "version": {
   "type": "string"
  },
  "date": {
   "type": "string"
  },
  "channel": {
   "type": "string"
  },
  "language": {
   "type": "string"
  },
  "video": {
   "type": "string"
  },
  "cover": {
   "type": "object",
   "properties": {
    "file": {
     "type": "string"
    },
    "frame_sec": {
     "type": "number"
    },
    "text": {
     "type": "string"
    }
   }
  },
  "product": {
   "type": "string"
  },
  "ai_label": {
   "type": "string"
  },
  "rules_read": {
   "type": "string",
   "description": "the date of references/posting-kit.md (data/organic-video/platform_rules.yaml as_of) its writer read; tm kit check refuses a kit without it"
  },
  "search_phrase": {
   "type": "string",
   "description": "the hook's or the topic's own words from the run's trend data; TikTok's first line leads with it"
  },
  "platforms": {
   "type": "object",
   "properties": {
    "tiktok": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string"
      },
      "caption": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "cover": {
       "type": "string"
      },
      "ai_label": {
       "type": "string"
      },
      "sound": {
       "type": "string"
      },
      "product": {
       "type": "string"
      },
      "hashtags": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "instagram": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string"
      },
      "caption": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "cover": {
       "type": "string"
      },
      "ai_label": {
       "type": "string"
      },
      "sound": {
       "type": "string"
      },
      "product": {
       "type": "string"
      },
      "hashtags": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "youtube": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string"
      },
      "caption": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "cover": {
       "type": "string"
      },
      "ai_label": {
       "type": "string"
      },
      "sound": {
       "type": "string"
      },
      "product": {
       "type": "string"
      },
      "hashtags": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "tags": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "facebook": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string"
      },
      "caption": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "cover": {
       "type": "string"
      },
      "ai_label": {
       "type": "string"
      },
      "sound": {
       "type": "string"
      },
      "product": {
       "type": "string"
      },
      "hashtags": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    }
   },
   "additionalProperties": false
  }
 },
 "description": "Checks (tm kit check, the limits of data/organic-video/platform_rules.yaml): on each platform the text as pasted (the caption with its hashtags; YouTube's title, description and tags): TikTok 3-5 hashtags and 2,200 UTF-16 characters, Instagram <=5 hashtags, <=2,200 characters and first line <=125, YouTube title <=100, description <=5,000 bytes with 2-3 hashtags, tags <=500, Facebook 1-3 hashtags; rules_read and search_phrase; no sources in any text."
}
